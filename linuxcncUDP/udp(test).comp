#include <sys/socket.h>
#include <arpa/inet.h>
#include <unistd.h>
#include <stdio.h>
#include <string.h>
#include <fcntl.h>          /* fcntl, O_NONBLOCK */
#include <errno.h>          /* errno, EAGAIN, EWOULDBLOCK */

#include <rtapi_slab.h>
#include <rtapi_ctype.h>
#include <rtapi_list.h>
#include <rtapi_math.h>
#include <rtapi_math64.h>

#include "rtapi.h"
#include "rtapi_app.h"
#include "rtapi_string.h"

#include "udpcompenet.h"

double Aci2Posizyon(double eskiAci, double gelenAci);

#define CTRL_DIRSETUP 0b00000001
#define CTRL_MAXVEL   0b00000010
#define CTRL_MAXACC   0b00000100
#define CTRL_READY    0
#define CTRL_ENABLE   0b10000000

#define IO_00 0b00000001
#define IO_01 0b00000010
#define IO_02 0b00000100
#define IO_03 0b00001000
#define IO_04 0b00010000
#define IO_05 0b00100000
#define IO_06 0b01000000
#define IO_07 0b10000000

/* tevfik  https://www.cplusplus.com/reference/cstdio/printf/ */
#define BUFSIZE 250
#define SEND_TIMEOUT_US 100
#define RECV_TIMEOUT_US 200     /* artık kullanılmıyor, referans için */
#define READ_PCK_DELAY_NS 10000 /* artık kullanılmıyor, referans için */
#define REMOTE_IP "192.168.1.2"
#define REMOTE_UDP_PORT 5000

int sockfd = -1;
int n;
struct sockaddr_in server;
struct timeval timeout;
char txbuf[BUFSIZE];
char rxbuf[BUFSIZE];

static float eski_aci_x;
static float eski_aci_y;
static float eski_aci_a;
static int   ilk_calisma;

/* X ekseni harmonik duzeltmesi icin yon tespiti: 'eski_aci_x' zaten
 * surekli/unwrap edilmis (wrap sicramasi yok) oldugu icin, raw acinin
 * diff'ini almak yerine bunun onceki dongudeki degerini saklayip
 * karsilastirmak cok daha guvenilir - wrap koruma mantigina gerek kalmiyor. */
static float onceki_eski_aci_x_harmonik;

static float ilk_aci_x, gelen_aci_x;
static float ilk_aci_y, gelen_aci_y;
static float ilk_aci_a, gelen_aci_a;
static float yhome_motor_pozisyonu;

/* İstatistik sayaçları — halcompile gövdede u32 tanımaz, int kullanıyoruz */
static int packet_ok  = 0;   /* toplam başarılı paket sayısı      */
static int packet_err = 0;   /* toplam başarısız deneme sayısı    */
static int recv_fails = 0;   /* ardışık başarısız deneme sayısı   */

/*-------------------------------------*/

EXTRA_SETUP()
{
    eski_aci_x = 0;
    eski_aci_y = 0;
    eski_aci_a = 0;

    ilk_aci_x = 0;
    ilk_aci_y = 0;
    ilk_aci_a = 0;

    ilk_calisma = 0;

    onceki_eski_aci_x_harmonik = 0;

    packet_ok  = 0;
    packet_err = 0;
    recv_fails = 0;

    sockfd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
    if (sockfd < 0) {
        rtapi_print_msg(RTAPI_MSG_ERR, "udp: socket olusturulamadi: %s\n", strerror(errno));
        return -1;
    }

    /* -------- Soketi non-blocking yap -------- */
    {
        int flags = fcntl(sockfd, F_GETFL, 0);
        if (flags < 0) {
            rtapi_print_msg(RTAPI_MSG_ERR, "udp: fcntl F_GETFL hatasi: %s\n", strerror(errno));
            close(sockfd);
            sockfd = -1;
            return -1;
        }
        if (fcntl(sockfd, F_SETFL, flags | O_NONBLOCK) < 0) {
            rtapi_print_msg(RTAPI_MSG_ERR, "udp: fcntl O_NONBLOCK hatasi: %s\n", strerror(errno));
            close(sockfd);
            sockfd = -1;
            return -1;
        }
    }
    /* ----------------------------------------- */

    server.sin_family = AF_INET;
    server.sin_port   = htons(REMOTE_UDP_PORT);
    server.sin_addr.s_addr = inet_addr(REMOTE_IP);

    /* SO_RCVTIMEO artık gerekmiyor (non-blocking sokette etkisizdir) */
    /* Sadece send için timeout bırakıyoruz */
    timeout.tv_sec  = 0;
    timeout.tv_usec = SEND_TIMEOUT_US;
    setsockopt(sockfd, SOL_SOCKET, SO_SNDTIMEO, (char*)&timeout, sizeof(timeout));

    return 0;
}

EXTRA_CLEANUP()
{
    if (sockfd >= 0) {
        close(sockfd);
        sockfd = -1;
    }
}

FUNCTION(_)
{
    /* ---------------------------------------------------------------
     * 1) HAL pinlerinden cmd.io bayrağını oluştur
     * --------------------------------------------------------------- */
    cmd.io = (cmd.io & 0xfe) + (  1 * pin_out(0));
    cmd.io = (cmd.io & 0xfd) + (  2 * pin_out(1));
    cmd.io = (cmd.io & 0xfb) + (  4 * pin_out(2));
    cmd.io = (cmd.io & 0xf7) + (  8 * pin_out(3));
    cmd.io = (cmd.io & 0xef) + ( 16 * pin_out(4));
    cmd.io = (cmd.io & 0xdf) + ( 32 * pin_out(5));
    cmd.io = (cmd.io & 0xbf) + ( 64 * pin_out(6));
    cmd.io = (cmd.io & 0x7f) + (128 * 1); /* pin_out(7) -> CTRL_ENABLE sabit 1 */

    ozel.veriC = cmd.io;

    /* ---------------------------------------------------------------
     * 2) TX paketini hazırla ve gönder  (pc -> stm32)
     * --------------------------------------------------------------- */
    rtapi_snprintf(txbuf, BUFSIZE, "%0.6f:%0.6f:%0.6f:AAA:%0.6f",
                   (float)_position_cmd(0),
                   (float)_position_cmd(1),
                   (float)ozel.veriC,
                   (float)packets);

    n = sendto(sockfd, txbuf, sizeof(txbuf) + 1, 0, &server, sizeof(server));
    if (n < 0) {
        /* Gönderim hatası — ready düşür */
        ready = 0;
    }

    /* ---------------------------------------------------------------
     * 3) RX: non-blocking TEK recvfrom — bekleme/döngü YOK
     * --------------------------------------------------------------- */
    n = recvfrom(sockfd, rxbuf, sizeof(rxbuf) - 1, 0, NULL, NULL);

    if (n > 0) {
        /* -------- Paket geldi -------- */
        rxbuf[n] = '\0';
        yeniposizyongeldi = 1;

        recv_fails = 0;      /* eski i=0 gibi: ardışık hata sıfırlanır */
        packet_ok++;

        packets      = recv_fails;   /* 0 */
        packetsgelen = packet_err;
    } else {
        /* -------- Paket yok (EAGAIN) -------- */
        yeniposizyongeldi = 0;

        recv_fails++;        /* eski i++ gibi: ardışık hata artar */
        packet_err++;

        packets      = recv_fails;   /* kaç cycle'dır paket gelmiyor */
        packetsgelen = packet_err;
        return;              /* pozisyon hesabını atla */
    }

    /* ---------------------------------------------------------------
     * 4) Paketi ayrıştır
     * --------------------------------------------------------------- */
    {
        int parsed = sscanf(rxbuf, "%f:%f:%f:",
                            &ozel.veriA, &ozel.veriB, &ozel.veriC);
        if (parsed != 3) {
            /* bozuk/eksik paket */
            return;
        }
    }

    if (ozel.veriC > 500) {
        ZPulseSinyal = 0;
    } else {
        ZPulseSinyal = 1;
    }

    gelen_aci_x = fmod((ozel.veriA * 360.0 / 4096.0), 360.0);

     /* --- X Ekseni Harmonik Duzeltmesi (AS5600 eksantriklik/gecikme) ---
     * Katsayilar angle_log CSV kalibrasyonundan (F5, ileri+geri toplam
     * ~32 tam tur) cikarildi. Ileri/geri egrileri neredeyse tam ayna
     * (isaret ters) ciktigi icin TEK katsayi seti + yon isareti yeterli.
     *
     * Yon tespiti: 'eski_aci_x' zaten surekli/unwrap edilmis (asagida,
     * 6. adimda guncelleniyor) - bu yuzden raw acinin wrap-korumali
     * diff'i yerine, bir onceki dongunun eski_aci_x degerini saklayip
     * karsilastirmak yeterli ve daha guvenilir (position_fb(0) zaten
     * bundan turuyor, ayni yon bilgisini tasiyor). Bu deger fonksiyonun
     * SONUNDA (adim 6'dan SONRA) guncellenir, yani burada kullanilan
     * karsilastirma bir onceki cevrimin yonunu yansitir (~15ms gecikme,
     * ihmal edilebilir).                                               */
    {
        const float DEG2RAD = (float)(M_PI / 180.0f);
        float theta_raw = gelen_aci_x;
        float yon_isareti = (eski_aci_x >= onceki_eski_aci_x_harmonik) ? -1.0f : 1.0f;

        /* --- Hiza bagli olcekleme ---
         * Katsayilar sadece F5'te (en yavas) kalibre edildi, ama genlik
         * hizla ~10 kata kadar buyuyor (F5:~0.20 deg -> F90:~1.91 deg,
         * A2 harmonigi bazinda). Sabit tabloyu F55-F90 gibi daha yuksek
         * hizlarda kullanmak, hatanin ~%90'ini duzeltmeden birakiyor.
         * Cozum: _velocity_cmd(0) (mm/s) uzerinden, iki kalibrasyon
         * noktasi (F5, F90) arasinda dogrusal interpolasyonla kazanc
         * hesapla. Bu KESIN degil (sadece 2 nokta), ama sabit tablodan
         * cok daha iyi bir yaklasim. Daha fazla hizda (orn. F20,40,60,80)
         * kalibrasyon yapilirsa bu egri iyilesir.                        */
        float v_mm_dak = fabsf((float)_velocity_cmd(0)) * 60.0f;
        const float V_LO = 5.0f,  GAIN_LO = 1.0f;   /* F5  kalibrasyonu  */
        const float V_HI = 90.0f, GAIN_HI = 9.74f;  /* F90 icin olcum orani (1.9085/0.196) */
        float hiz_kazanci;

        if (v_mm_dak <= V_LO) {
            hiz_kazanci = GAIN_LO;
        } else if (v_mm_dak >= V_HI) {
            hiz_kazanci = GAIN_HI;
        } else {
            hiz_kazanci = GAIN_LO + (v_mm_dak - V_LO) / (V_HI - V_LO) * (GAIN_HI - GAIN_LO);
        }

        /* Birlesik (fwd - rev)/2) katsayilari, 32 tur esdegeri (F5 bazli) */
        float term1 =  0.00837f * sinf(1.0f * theta_raw * DEG2RAD)
                     + 0.03527f * cosf(1.0f * theta_raw * DEG2RAD);
        float term2 =  0.15342f * sinf(2.0f * theta_raw * DEG2RAD)
                     - 0.13011f * cosf(2.0f * theta_raw * DEG2RAD);
        float term3 = -0.02466f * sinf(3.0f * theta_raw * DEG2RAD)
                     + 0.03610f * cosf(3.0f * theta_raw * DEG2RAD);

        gelen_aci_x = theta_raw - yon_isareti * hiz_kazanci * (term1 + term2 + term3);
    }

    xeksen_aci_fb = (float)gelen_aci_x;

    gelen_aci_y = fmod((ozel.veriB * 360.0 / 4096.0), 360.0);
    yeksen_aci_fb = (float)gelen_aci_y;

    gelen_aci_a = fmod((ozel.veriC * 360.0 / 2000.0), 360.0);
    aeksen_aci_fb = (float)gelen_aci_a;

    /* ---------------------------------------------------------------
     * 5) İlk çalışma başlangıç değerleri
     * --------------------------------------------------------------- */
    if (ilk_calisma == 0) {
        ilk_calisma = 1;
        eski_aci_x = gelen_aci_x;
        eski_aci_y = gelen_aci_y;

        ilk_aci_x = 0.017638888888889 * gelen_aci_x;
        ilk_aci_y = 0.017638888888889 * gelen_aci_y;
        ilk_aci_a = gelen_aci_a / (172.74);
    }

    /* ---------------------------------------------------------------
     * 6) Açı sürekliliği (multi-turn unwrap)
     * --------------------------------------------------------------- */
    eski_aci_y = Aci2Posizyon((double)eski_aci_y, (double)gelen_aci_y);
    eski_aci_x = Aci2Posizyon((double)eski_aci_x, (double)gelen_aci_x);
    eski_aci_a = Aci2Posizyon((double)eski_aci_a, (double)gelen_aci_a);

    /* ---------------------------------------------------------------
     * 7) Geri besleme pozisyonları
     *    0.017638888888889 = 6.35 / 360
     * --------------------------------------------------------------- */
    _position_fb(0) = (0.017638888888889 * eski_aci_x) - ilk_aci_x;
    _position_fb(1) = (0.017638888888889 * eski_aci_y) - ilk_aci_y;

    /* 1/120 gear oranı */
    _position_fb(3) = ((eski_aci_a - ilk_aci_a) / (172.74));

    /* ---------------------------------------------------------------
     * 8) HAL debug/izleme pinleri
     * --------------------------------------------------------------- */
    ozelveri_x   = eski_aci_x;
    ozelveri_y   = eski_aci_y;
    ozelveri_a   = eski_aci_a;

    toplamXacisi = eski_aci_x;
    toplamYacisi = eski_aci_y;
    toplamAacisi = eski_aci_a;

    /* Bir sonraki cevrimin harmonik-duzeltme yon tespiti icin,
     * bu cevrimin (guncellenmis) eski_aci_x degerini sakla. */
    onceki_eski_aci_x_harmonik = eski_aci_x;
}

/* ------------------------------------------------------------------
 * Açı sürekliliği: [-180,180] en kısa yoldan eklemeli unwrap
 * 120 dereceden büyük ani sıçramalar reddedilir (encoder hatası)
 * ------------------------------------------------------------------ */
double Aci2Posizyon(double eskiAci, double gelenAci)
{
    double eskiAciMod;
    double aciFarki;
    const double maxSicrama = 120.0;

    /* 1) Gelen açıyı [0, 360) aralığına normalize et */
    gelenAci = fmod(gelenAci, 360.0);
    if (gelenAci < 0.0) {
        gelenAci += 360.0;
    }

    /* 2) Eski açının 0-360 aralığındaki modüler karşılığı */
    eskiAciMod = fmod(eskiAci, 360.0);
    if (eskiAciMod < 0.0) {
        eskiAciMod += 360.0;
    }

    /* 3) En kısa açısal fark [-180, 180] */
    aciFarki = gelenAci - eskiAciMod;

    if (aciFarki > 180.0) {
        aciFarki -= 360.0;
    } else if (aciFarki < -180.0) {
        aciFarki += 360.0;
    }

    /* 4) Ani sıçrama reddi */
    if (fabs(aciFarki) >= maxSicrama) {
        return eskiAci;
    }

    /* 5) Kesintisiz eklemeli açı */
    return eskiAci + aciFarki;
}
