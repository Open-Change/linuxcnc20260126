component udp "HAL2UDP";

pin in  float   #.position_cmd[4]   = 0.0   "commanded position in position units";
pin in  float   #.velocity_cmd[4]   = 0.0   "commanded velocity in position units/s";
pin out float   #.position_fb[4]    = 0.0   "feedback position in position units";
pin out float   #.velocity_fb[4]    = 0.0   "feedback velocity in position units/s";

pin in  bit     pin.##.out[8]       = 0     "Digital output";
// hal file   udp.pin.01.out
// net  example    spindle-on      spindle.0.on                udp.pin.01.out
pin out bit     pin.##.in[8]        = 0     "Digital inputs";

pin out bit     ready               = 0     "Module state";
pin in  bit     enable              = 0     "Module enable";



 
pin in  bit     allhomeoldu            	= 0     "Module enable";
pin in  bit     xhomeoldu	            = 0     "Module enable";
pin in  bit     yhomeoldu	            = 0     "Module enable";
pin in  bit     zhomeoldu	            = 0     "Module enable";
pin out  bit     ZPulseSinyal	            = 0     "Module enable";

pin out  bit yeniposizyongeldi   =0;


pin out float     packets             = 0;
pin out float     packetsgelen       = 0;
pin out float     ozelveri            = 0;

pin out float     toplamXacisi            = 0;
pin out float     toplamYacisi            = 0;
pin out float     toplamAacisi            = 0;

pin out float     xeksen_aci_fb            = 0;
pin out float     yeksen_aci_fb            = 0;
pin out float     aeksen_aci_fb            = 0;


pin out float     ozelveri_x            = 0;
pin out float     ozelveri_y            = 0;
pin out float     ozelveri_a            = 0;

pin in  float   #.motor.pos_cmd[4]   = 0.0   "commanded position in position units";
pin out s32     zero       = 0;



param   rw  u32     #.dirsetup[4]   = 1     "Minimum time from a direction change to the beginning of the next step pulse in ns";
param   rw  float   #.scale[4]      = 1.0   "Steps per position unit";
param   rw  float   #.maxvel[4]     = 1.0   "Maximum velocity in position units/s";
param   rw  float   #.maxacc[4]     = 1.0   "Maximum acceleration in position units/s2";

