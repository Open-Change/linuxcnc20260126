double Aci2Posizyon(double eskiAci, double gelenAci)
{
    double eskiAciMod;
    double aciFarki;
    double maxSicrama = 120.0;

    // 1. Gelen açıyı [0, 360) aralığına normalize et
    gelenAci = fmod(gelenAci, 360.0);
    if (gelenAci < 0.0) {
        gelenAci += 360.0;
    }

    // 2. Eski açının 0-360 aralığındaki modüler karşılığını bul
    eskiAciMod = fmod(eskiAci, 360.0);
    if (eskiAciMod < 0.0) {
        eskiAciMod += 360.0;
    }

    // 3. İki açı arasındaki en kısa açısal farkı [-180, 180] aralığında hesapla
    aciFarki = gelenAci - eskiAciMod;
 
    if (aciFarki > 180.0) {
        aciFarki -= 360.0;
    } else if (aciFarki < -180.0) {
        aciFarki += 360.0;
    }

    // 4. Ani sıçrama kontrolü (180 derece veya daha büyük ani değişimler reddedilir)
    if (fabs(aciFarki) >= maxSicrama) {
   
        return eskiAci; // Hatalı okumada pozisyonu değiştirme aynı kalsın
    }

    // 5. Kesintisiz eklemeli yeni açıyı döndür
    return eskiAci + aciFarki;
}




