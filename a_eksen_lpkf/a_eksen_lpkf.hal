# loadusr -W pyvcp -c pyvcp test.xml  #==>> bagımsız olması pasif et.a_eksen_lpkf.ini file kısmını pasif et 

 
loadrt [KINS]KINEMATICS
loadrt [EMCMOT]EMCMOT base_period_nsec=[EMCMOT]BASE_PERIOD servo_period_nsec=[EMCMOT]SERVO_PERIOD num_joints=[KINS]JOINTS
loadrt hal_parport cfg="0 out"
loadrt stepgen step_type=0,0,0,0      ctrl_type=v,v,p,v

    # dir step steplen stepspace dırsetup dirhold 
   	# ======= X axis ===========================
 	# bu sekilde olursa step motor hız modunda olacak
 	# loadrt stepgen step_type=0,0,0,0   ctrl_type=v,p,p,p
	# bu sekilde olursa step motor velocity modunda olacak
	# pid velocity calışıyor
	# ======= X axis =========================== 
	
	
 

 loadrt  threads name1=udp-thread period1=[EMCMOT]UDP_PERIOD fp1=1
 
 
 
 
 
loadrt udp
  addf udp               udp-thread

loadrt  pid    names=pid.y,pid.x,pid.a 

#addf    pid.y.do-pid-calcs           udp-thread
#addf    pid.x.do-pid-calcs           udp-thread
#addf    pid.a.do-pid-calcs           udp-thread
# PID Hesaplamaları 1 ms'lik Hızlı Thread'e Alındı
addf pid.x.do-pid-calcs        servo-thread
addf pid.y.do-pid-calcs        servo-thread
addf pid.a.do-pid-calcs        servo-thread

 # 1. derece IIR filtre (EMA)
loadrt lowpass count=2
addf lowpass.0      udp-thread
addf lowpass.1      udp-thread

# Filtre parametresi (alpha)
# alpha = 0.95  → ağır ve stabil
setp lowpass.0.gain 0.5942
setp lowpass.1.gain 0.5942
# canlı ayar halcmd setp lowpass.0.gain 0.07 # bir önceki değer =0.42 idi
# x ekseni için yapıldı gayet iyi filitre pidx ile xvel bağlı

 
#örnek
#net pos-raw     encoder.0.position  => lowpass.0.in
#net pos-filter  lowpass.0.out       => pid.0.feedback



# =========== PWMGEN yükleniyor ve servo-thread'e ekleniyor ============
loadrt pwmgen output_type=1
addf pwmgen.make-pulses        servo-thread
addf pwmgen.update             servo-thread

 loadrt ddt count=2
 addf ddt.0                     servo-thread
 addf ddt.1                     servo-thread
 
 



addf parport.0.read       base-thread
addf stepgen.make-pulses  base-thread
addf parport.0.write      base-thread

addf stepgen.capture-position   servo-thread
addf motion-command-handler     servo-thread
addf motion-controller          servo-thread
addf stepgen.update-freq        servo-thread






