# Generated by stepconf 1.1 at Sun Dec 11 16:36:43 2022
# If you make changes to this file, they will be
# overwritten when you run stepconf again

[EMC]
MACHINE = a_eksen_lpkf
DEBUG = 0
VERSION = 1.1

[DISPLAY]
DISPLAY = axis
EDITOR = gedit
POSITION_OFFSET = RELATIVE
POSITION_FEEDBACK = ACTUAL
ARCDIVISION = 64
GRIDS = 10mm 20mm 50mm 100mm 1in 2in 5in 10in
MAX_FEED_OVERRIDE = 1.2
MIN_SPINDLE_OVERRIDE = 0.5
MAX_SPINDLE_OVERRIDE = 1.2
DEFAULT_LINEAR_VELOCITY = 1.30
MIN_LINEAR_VELOCITY = 0
MAX_LINEAR_VELOCITY = 3.00
DEFAULT_ANGULAR_VELOCITY = 4.00
MIN_ANGULAR_VELOCITY = 0
MAX_ANGULAR_VELOCITY = 3.00
INTRO_GRAPHIC = linuxcnc.gif
INTRO_TIME = 5
PROGRAM_PREFIX = /home/tevfik/linuxcnc/nc_files
INCREMENTS = 5mm 1mm .5mm .1mm .05mm .01mm .005mm

PYVCP =test.xml     
#consol loadusr   pyvcp test.xml


#EMBED_TAB_NAME = Camera
      #EMBED_TAB_COMMAND =  mplayer -wid {XID} tv://0
#EMBED_TAB_COMMAND = mplayer tv://0 -vf rectangle=-1:2:-1:240,rectangle=2:-1:320:-1
#EMBED_TAB_COMMAND = mplayer  -wid {XID} tv://0 -vf rectangle=-1:2:-1:240,rectangle=2:-1:320:-1


[KINS]
JOINTS = 4
KINEMATICS = trivkins coordinates=XYZA

[FILTER]
PROGRAM_EXTENSION = .png,.gif,.jpg Greyscale Depth Image
PROGRAM_EXTENSION = .py Python Script
PROGRAM_EXTENSION = .nc,.tap G-Code File
png = image-to-gcode
gif = image-to-gcode
jpg = image-to-gcode
py = python




[TASK]
TASK = milltask
CYCLE_TIME = 0.010

[RS274NGC]
PARAMETER_FILE = linuxcnc.var


SUBROUTINE_PATH = macros

REMAP=M6    modalgroup=6 ngc=cakiyi-degistirver2
REMAP=M601  modalgroup=6 ngc=probe-hole-merkez
REMAP=M600  modalgroup=6 ngc=master-caki-olcme
# her gcode M600 ilave edilecek   



[EMCMOT]
EMCMOT = motmod
COMM_TIMEOUT	 = 1.0
BASE_PERIOD 	=  250000
SERVO_PERIOD 	= 1000000
UDP_PERIOD		= 1000000



[HAL]
HALFILE = a_eksen_lpkf.hal
HALFILE = custom.hal
POSTGUI_HALFILE = postgui_call_list.hal


[TRAJ]
COORDINATES =  X Y Z A
LINEAR_UNITS = mm
ANGULAR_UNITS = degree
DEFAULT_LINEAR_VELOCITY = 4.00
MAX_LINEAR_VELOCITY = 3.00



NO_FORCE_HOMING = 1 
POSITION_FILE = position.txt 
#kullanılırken eksen hareket sınırlarınızı bilmeyecek

[EMCIO]
EMCIO = io
CYCLE_TIME = 0.100
TOOL_TABLE = tool.tbl

[AXIS_X]
MAX_VELOCITY = 3.0
MAX_ACCELERATION = 100.0
MIN_LIMIT = -1.1
MAX_LIMIT = 323.01

[JOINT_0]
TYPE = LINEAR
HOME = 0.0
MIN_LIMIT = -1.1
MAX_LIMIT = 323.01
MAX_VELOCITY = 3.0
MAX_ACCELERATION = 100.0
STEPGEN_MAXACCEL = 125.0
#SCALE = 505.314114827
SCALE = 253.1788
