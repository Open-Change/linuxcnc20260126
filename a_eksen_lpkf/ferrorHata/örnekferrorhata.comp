component ferrorhata "Monitors X/Y ferror; continuous LED if >1.0; reduces feed to 10% immediately";

license "GPL";

pin in  float x_ferror      "X axis following error";
pin in  float y_ferror      "Y axis following error";
pin in  float feed_in       "Input: halui.feed-override.value (0.0–1.0)";

pin out bit x_ferror_ledi   "X error LED (ON while |x_ferror| > 1.0)";
pin out bit y_ferror_ledi   "Y error LED (ON while |y_ferror| > 1.0)";
pin out bit any_ferror_ledi "Common LED (ON if X or Y error > 1.0)";
pin out float feed_out      "Output: connect to motion.feed-override";

function _;

;;

#include <math.h>
#include "rtapi.h"
#include "rtapi_app.h"

static int feed_slow_active = 0;
static float saved_feed_override = 1.0;

FUNCTION(_) {
    // LED’ler: doğrudan hata eşik kontrolüne göre
    x_ferror_ledi = (fabs(x_ferror) > 1.0);
    y_ferror_ledi = (fabs(y_ferror) > 1.0);
    any_ferror_ledi = x_ferror_ledi || y_ferror_ledi;

    // Feed override: halui'den oku, gerekirse %10 yap
    if (any_ferror_ledi) {
        if (!feed_slow_active) {
            saved_feed_override = feed_in;  // son geçerli değeri sakla
            feed_slow_active = 1;
        }
        feed_out = 0.1f;  // %10
    } else {
        if (feed_slow_active) {
            feed_out = saved_feed_override;
            feed_slow_active = 0;
        } else {
            // Hata yoksa doğrudan geç
            feed_out = feed_in;
        }
    }
}
