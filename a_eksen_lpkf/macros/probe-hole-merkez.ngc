O<probe-hole-merkez> SUB

M70                                            ( Mevcut modal durumları kaydet )
M9                                             ( Soğutmayı kapat – probing için şart )
M5                                             ( Spindle durdur – prob sırasında çalışamaz )

;M72                                            ( M70 ile kaydedilen durumları geri yükler – burada devre dışı )


G54                     ( G54 iş parçası ofseti )
G21                     ( mm modu )
F100                    ( Genel hızlı ilerleme )

G90                     ( Mutlak koordinat modu ) 
G53 G1 Z-10             ( Makine koordinatında Z yukarı hareket )
G53 G1 X30 Y40        ( Delik merkezine yaklaşma konumu – makine koordinatı )
G53 G1 Z-45          ( Prob ucu deliğin içine girer – makine koordinatı )

#1000=28               ( Delik yarıçapı tahmini – probun gideceği max mesafe )
F50                     ( Probing hızını düşür )

;G91 G38.3 Z-1          ( Temas varsa dur – kullanılmıyor )

G91 G38.3 Z-4           ( Göreli modda Z aşağı doğru max 4 mm ilerleyerek yüzey arar )
#1001=#5061             ( İlk temas X konumu )
#1002=#5062             ( İlk temas Y konumu )


;---------------------------
; X pozitif yön ilk temas
;---------------------------
G91 G38.2 X#1000    G4 P0.1    ( X+ yönünde temas ara )
#1003=#5061             ( X+ temas noktası kaydet )

G90 G0 X#1001        G4 P0.1   ( İlk başlangıç noktasına dön )
G91 G38.2 X[0-#1000]    ( X− yönünde temas ara )
#1004=#5061             ( X− temas noktası kaydet )

#1001=[[#1003+#1004]/2] ( İlk X orta noktası )
G90 G0 X#1001           ( X orta noktasına git )

;---------------------------
; Y pozitif yön ilk temas
;---------------------------
G91 G38.2 Y#1000     G4 P0.1   ( Y+ yönünde temas )
#1005=#5062             ( Y+ temas noktası )

G90 G0 Y#1002
G91 G38.2 Y[0-#1000]   G4 P0.1 ( Y− yönünde temas )
#1006=#5062             ( Y− temas noktası )

#1002=[[#1005+#1006]/2] ( İlk Y orta noktası )
G90 G0 Y#1002           ( Y orta noktasına git )


;---------------------------
; Aynı işlemler tekrar (X eksenini merkeze oturtmak için ikinci ölçüm)
;---------------------------
G91 G38.2 X#1000    G4 P0.1
#1003=#5061

G90 G0 X#1001
G91 G38.2 X[0-#1000] G4 P0.1
#1004=#5061

#1001=[[#1003+#1004]/2] ( Daha hassas X merkezi )
G90 G0 X#1001


;---------------------------
; Y ekseni ikinci hassas ölçüm
;---------------------------
G91 G38.2 Y#1000   G4 P0.1
#1005=#5062

G90 G0 Y#1002
G91 G38.2 Y[0-#1000] G4 P0.1
#1006=#5062

#1002=[[#1005+#1006]/2]   ( Daha hassas Y merkezi )
G90 G0 Y#1002


;---------------------------
; Daha hassas düşük hızlı final probing
;---------------------------
F1                       ( Çok yavaş hızda final temas ölçümü )

;--- X hassas final ---
G90 G0 X[#1003-0.2]      ( X+ temas öncesi hafif geri çekilme )
G91 G38.2 X1.010     G4 P0.1    ( X+ yönünde yavaş temas )
#1003=#5061              ( Güncel X+ temas noktası )

G90 G0 X[#1004+0.2]      ( X− temas öncesi hafif geri çek )
G91 G38.2 X-1.010      G4 P0.1  ( X− yönünde yavaş temas )
#1004=#5061              ( Güncel X− temas )

#1001=[[#1003+#1004]/2]  ( Final X merkezi )
G90 G0 X#1001


;--- Y hassas final ---
G90 G0 Y[#1005-0.2]
G91 G38.2 Y1.010      G4 P0.1   ( Y+ yönünde hassas temas )
#1005=#5062

G90 G0 Y[#1006+0.2]
G91 G38.2 Y-1.010     G4 P0.1   ( Y− yönünde hassas temas )
#1006=#5062

#1002=[[#1005+#1006]/2]  ( Final Y merkezi )
G90 G0 Y#1002

G90                     ( Güvenlik için mutlak moda dön )


;---------------------------
; Çap ve açı hesaplamaları
;---------------------------
#1007=[#1003-#1004+[3.60]]          ([4.0/25.4]]   X yönü çap hesaplaması ? 6/25.4 = 0.236" – prob çap düzeltmesi gibi )
#1008=[#1005-#1006+[3.60]]          ([4.0/25.4]]   Y yönü çap hesabı )
#1009=[[#1007+#1008]/2]         ( Ortalama çap )

#1010=[atan[#1002]/[#1001]]     ( Merkez kaymasının açısı – çok gerekli değil )
#1011=[sqrt[[#1001*#1001]+[#1002*#1002]]]  ( Merkezden uzaklık vektörü )

#1012=#5221  ( G54 mevcut X ofseti )
#1013=#5222  ( G54 mevcut Y ofseti )


;(debug,Dia #1009 Ang #1010 Dist #1011)


;(debug,cap #1009 mx=#5221 my=#5222)


; G10 L2 P1 X0 Y0 Z0     ( Burada kullanılmayan eski offset sıfırlama satırı )


G10 L20 P1 X30 Y40       ( G54 ofsetini X=5, Y=37 olarak yaz – test amaçlı )

#1012=[#1012-#5221]      ( Yeni ofsete göre X farkı )
#1013=[#1013-#5222]      ( Yeni ofsete göre Y farkı )

(debug,cap #1009 deltax=#1012 deltay=#1013)

G1 F120 Z-10             ( Güvenli çıkış )


M72                      ( Kaydedilmiş modal durumları geri yükle )
O<probe-hole-merkez> ENDSUB
 
M2
